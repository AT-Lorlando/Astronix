TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
SESSION_DRIVER=cookie
# Set to true only when serving over HTTPS (leave false for http:// / LAN)
SESSION_COOKIE_SECURE=false

# Admin panel account (used by `node ace db:seed` to create the /admin login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Push notification via Yui on new contact message / recommendation (optional)
# e.g. YUI_URL=http://10.0.0.101:10001 ; YUI_BEARER = Yui's BEARER_TOKEN
YUI_URL=
YUI_BEARER=

# Same notification by e-mail, from your own mailbox to itself (optional)
# 465 = TLS, 587 = STARTTLS ; MAIL_TO defaults to SMTP_USER
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
